# ------------------------------------------
# Frontend Firebase Client Configuration
# ------------------------------------------
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="tvm-hackers-hub.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tvm-hackers-hub"
VITE_FIREBASE_STORAGE_BUCKET="tvm-hackers-hub.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef0123456789"

# ------------------------------------------
# Administrator Authorization Configuration
# ------------------------------------------
VITE_ADMIN_EMAIL="tvmhackershub@gmail.com"
VITE_ADMIN_PASSWORD="CWtvmhackeradmin$$$"
ADMIN_EMAIL="tvmhackershub@gmail.com"
ADMIN_DEFAULT_PASS="CWtvmhackeradmin$$$"

# ------------------------------------------
# Serverless Email Configuration (Nodemailer / SMTP)
# ------------------------------------------
SMTP_HOST="smtp.gmail.com"
EMAIL_HOST="smtp.gmail.com"
SMTP_PORT=587
EMAIL_PORT=587
SMTP_USER="tvmhackershub@gmail.com"
EMAIL_USER="tvmhackershub@gmail.com"
SMTP_PASS="your-16-character-app-password"
EMAIL_PASSWORD="your-16-character-app-password"
EMAIL_FROM="TVM Hacker Hub <tvmhackershub@gmail.com>"
